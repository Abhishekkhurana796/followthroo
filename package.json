{
  "name": "followthroo",
  "version": "0.1.0",
  "private": true,
  "description": "Followthroo — AI-powered multi-channel outreach platform (email, LinkedIn, WhatsApp, social).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "desktop": "npm start --prefix desktop",
    "desktop:dist": "npm run dist --prefix desktop",
    "verify:linkedin": "tsx scripts/verify-linkedin-target.ts && tsx scripts/verify-desktop-api-client.ts && tsx scripts/verify-desktop-renderer.ts && tsx scripts/verify-desktop-runner.ts && tsx scripts/verify-linkedin-pilot.ts && tsx scripts/verify-connect-flow.ts",
    "verify:inbound": "tsx scripts/verify-inbound-adapters.ts",
    "verify:linkedin-enrichment-selectors": "tsx scripts/verify-linkedin-enrichment-selectors.ts",
    "verify:lead-import": "tsx scripts/verify-lead-import-parser.ts",
    "check:task-notifications": "tsx --env-file=.env --env-file=.env.local scripts/check-qstash-schedules.ts",
    "ensure:task-notifications": "tsx --env-file=.env --env-file=.env.local scripts/ensure-task-notification-schedules.ts",
    "verify:sending-account-access": "tsx scripts/verify-sending-account-access.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@floating-ui/react": "^0.27.20",
    "@prisma/client": "^6.1.0",
    "@upstash/qstash": "^2.7.2",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "imapflow": "^1.4.3",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "nodemailer": "^6.9.16",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "twilio": "^5.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
