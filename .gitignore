# dependencies
node_modules/
.pnp
.pnp.*

# next.js
.next/
*.tsbuildinfo
out/
build/
next-env.d.ts

# production
dist/

# secrets — never commit these.
# The glob is deliberately broad: a `.env.local.bak-1786350040` written by a
# quick backup is just as sensitive as the file it copied.
.env
.env.*
!.env.example
*.bak
*.bak-*

# prisma generated client
prisma/generated/

# testing
coverage/
playwright-report/
test-results/
/e2e/.auth/
# scratch output from agent-driven browser sessions
.playwright-mcp/

# misc
.DS_Store
*.pem
.vercel
.idea/
.vscode/*
!.vscode/extensions.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
# Must come AFTER the .env* rule above: git applies the last matching pattern,
# so an earlier negation is silently overridden. Without this line a fresh clone
# would drop .env.example (it survives today only because it is already tracked).
!.env.example

# Chrome Web Store upload artifact — built by scripts/package-extension.ts
followthroo-linkedin-*.zip

# desktop app — its own dependency tree, its build output, and the browser
# profile a local run signs into. The profile holds a live LinkedIn session:
# committing it would put one person's login in everybody's checkout.
desktop/node_modules/
desktop/dist/
desktop/linkedin-profile/
verify-runner.log

# dev server output, written by `npm run dev > dev.log`
dev.log

# Run logs written by the desktop runner. The verification suite passes an
# empty userDataPath, so they land here rather than in the app data folder.
logs/
