{
  "name": "followthroo-linkedin-desktop",
  "productName": "Followthroo for LinkedIn",
  "version": "1.15.1",
  "private": true,
  "description": "Runs Followthroo LinkedIn invitations and profile enrichment from your own computer.",
  "main": "main.js",
  "author": "Followthroo",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.followthroo.linkedin",
    "productName": "Followthroo for LinkedIn",
    "files": [
      "*.js",
      "renderer/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://wet59gidjhcn7yck.public.blob.vercel-storage.com",
        "channel": "latest"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "followthroo-linkedin-setup-${version}.${ext}"
    }
  }
}
