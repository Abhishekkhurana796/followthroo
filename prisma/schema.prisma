// LeadsKonnect data model — mirrors docs/crm-data-model.md
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Supabase pooler :6543, ?pgbouncer=true) for runtime
  directUrl = env("DIRECT_URL") // direct/session (:5432) for migrations & db push
}

enum LeadStage {
  new
  contacted
  replied
  qualified
  won
  lost
}

enum Channel {
  email
  linkedin
  whatsapp
  social
}

enum MessageStatus {
  queued
  sent
  delivered
  bounced
  replied
  failed
  /// Confidence-gated autonomy (product PRD §7): the agent wrote this but wasn't
  /// confident enough to send unattended — awaiting human approval on the Agent page.
  draft
}

enum CampaignStatus {
  draft
  active
  paused
  done
}

enum SuppressionReason {
  unsubscribe
  bounce
  gdpr
  manual
}

model Lead {
  id             String    @id @default(uuid())
  organizationId String? // tenant scope — always set in code (see lib/tenant.ts); nullable only for legacy backfill
  firstName      String?
  lastName       String?
  email          String? // optional — LinkedIn-only contacts (Book 2) have a profile link but no email
  phone          String? // encrypt at rest (see docs/security.md)
  linkedinUrl    String?
  company        String?
  title          String?
  stage          LeadStage @default(new)
  tags           String[]
  custom         Json      @default("{}") // extra CSV columns → template variables
  optedOut       Boolean   @default(false)
  consent        Json      @default("{}") // per-channel opt-in + timestamps (GDPR)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ---- scoring v1 (product PRD §6) ----
  // 0-100, recomputed by lib/scoring.ts on capture and on inbound reply. The three
  // qualifying signals are manually set for now (AI-driven extraction is a later phase);
  // nullable/unset reads as "not yet known", not "no".
  score                  Int?
  budgetMentioned        Boolean?
  timelineMentioned      Boolean?
  decisionMakerConfirmed Boolean?

  // ---- ownership (who this contact belongs to) ----
  // Raw userIds with no foreign key, matching the Task.ownerId / PipelineItem.ownerId
  // convention: memberships are per-org and a person can be removed from one without
  // their historical work needing to vanish.
  //
  // Before these existed, ownership had to be inferred at read time from the lead's
  // open PipelineItem — fine for display, useless for a `where`, which is what a
  // member-scoped view actually needs.
  /// Assigned rep. Null means unassigned — a claimable pool, not hidden.
  ownerId     String?
  /// Who added the contact. Distinct from ownerId: importing 500 leads does not
  /// make you the rep working all 500.
  createdById String?
  /// user | import | webhook | ai — so "you added this" and "IndiaMART sent this"
  /// stay distinguishable in reporting.
  createdKind String  @default("user")

  messages           Message[]
  activities         ActivityLog[]
  enrollments        Enrollment[]
  inboxThreads       InboxThread[]
  contactIdentities  ContactIdentity[]
  tasks              Task[]
  notes              Note[]
  leadSource         LeadSource?         @relation(fields: [leadSourceId], references: [id])
  leadSourceId       String?
  pipelineItems      PipelineItem[]
  conversationEvents ConversationEvent[]
  linkedInActions    LinkedInAction[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, linkedinUrl])
  // Drives the per-member lead scope (lib/scope.ts) without a table scan.
  @@index([organizationId, ownerId])
  @@index([organizationId, createdById])
  @@index([stage])
  @@index([optedOut])
}

model Campaign {
  id               String          @id @default(uuid())
  organizationId   String? // tenant scope
  name             String
  status           CampaignStatus  @default(draft)
  sequence         Json            @default("[]") // node graph: send/condition/wait/exit nodes with edges (see lib/campaign-engine.ts)
  createdBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sendingAccountId String?
  sendingAccount   SendingAccount? @relation(fields: [sendingAccountId], references: [id], onDelete: SetNull)

  messages    Message[]
  activities  ActivityLog[]
  enrollments Enrollment[]

  @@index([organizationId])
}

model Template {
  id             String    @id @default(uuid())
  organizationId String? // tenant scope
  channel        Channel
  name           String
  /// The live copy. Kept on the row (rather than only on TemplateVersion) so
  /// every existing read path — seeding, the campaign send, the list — keeps
  /// working untouched; a version is a snapshot of these two fields.
  subject        String?
  body           String
  variables      Json      @default("[]") // declared vars + required fallbacks
  createdById    String?
  /// Soft delete. A hard delete would leave Message.templateId dangling, and
  /// because processSendJob resolves the body at send time, a missing template
  /// resolves to null and sends an EMPTY email rather than failing.
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versions TemplateVersion[]

  @@index([organizationId])
  @@index([organizationId, archivedAt])
}

/// An immutable snapshot of a template's wording.
///
/// The reason this exists: lib/job-processor.ts resolves a template's body at
/// the moment of sending, from templateId alone. So editing a template silently
/// rewrote every unsent step of every in-flight sequence — someone mid-way
/// through a five-touch campaign would receive touches 1-2 in the old wording
/// and 3-5 in the new. A campaign step can now pin the version it was built
/// with, which is what makes "apply to future campaigns only" mean anything.
model TemplateVersion {
  id          String   @id @default(uuid())
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// 1-based, per template.
  version     Int
  subject     String?
  body        String
  variables   Json     @default("[]")
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([templateId, version])
  @@index([templateId])
}

model Message {
  id              String        @id @default(uuid())
  organizationId  String? // tenant scope
  leadId          String
  campaignId      String?
  channel         Channel
  templateId      String?
  renderedSubject String?
  renderedBody    String?
  status          MessageStatus @default(queued)
  providerId      String? // external message id (Twilio SID, SMTP id, …)
  /// The RFC-822 Message-ID header we set on the way out, e.g.
  /// "<uuid.orgId@sending.domain>". This is what makes a reply provably a reply:
  /// an inbound mail whose In-Reply-To or References names it is answering THIS
  /// message, on this campaign, rather than merely coming from the same address.
  rfcMessageId    String?
  idempotencyKey  String        @unique
  sentAt          DateTime?
  createdAt       DateTime      @default(now())

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
  @@index([status])
  // The reply poller looks messages up by header on every inbound mail.
  @@index([organizationId, rfcMessageId])
}

model ActivityLog {
  id             String   @id @default(uuid())
  organizationId String? // tenant scope
  leadId         String
  campaignId     String?
  messageId      String? // links opens/clicks back to the Message (unique-rate aggregation)
  type           String // sent/opened/clicked/delivered/bounced/replied/invite_accepted/unsubscribed
  channel        Channel?
  meta           Json     @default("{}")
  at             DateTime @default(now())

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
  @@index([type])
  @@index([messageId])
}

model Suppression {
  id             String            @id @default(uuid())
  organizationId String? // tenant scope
  email          String?
  phone          String?
  linkedinUrl    String?
  reason         SuppressionReason
  at             DateTime          @default(now())

  @@unique([organizationId, email])
  @@index([organizationId])
}

/// Tamper-evident compliance ledger (product PRD §12 differentiator): an append-only,
/// hash-chained log of consent/suppression events. Each entry's hash includes the
/// previous entry's hash (lib/compliance-ledger.ts), so altering any past entry breaks
/// every hash after it — a verifiable, exportable audit trail rather than a table that
/// could be quietly edited.
model ComplianceLedgerEntry {
  id             String   @id @default(cuid())
  organizationId String
  /// 1-based, per-org, gap-free — the position in the chain.
  sequence       Int
  eventType      String
  payload        Json
  prevHash       String
  hash           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, sequence])
  @@index([organizationId, createdAt])
}

// ---- better-auth (Stage 1: email/password; Stage 2 adds OAuth accounts) ----
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  members         Member[]
  sentInvitations Invitation[]

  // ---- app-owned user state ----
  // All nullable with NO defaults, deliberately: better-auth's prismaAdapter
  // writes only the fields above, so any non-nullable addition would break its
  // inserts, and a @default would read as schema drift to `better-auth generate`.
  // These are read/written server-side via /api/onboarding, not through the
  // session payload — a cookie-cached session would keep replaying a finished
  // tour until the cache expired.
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  onboardingStep        Int? // last-seen step index, so a mid-tour reload resumes
  tourVersion           Int? // TOUR_VERSION they finished; a bump re-offers the tour
  checklistState        Json? // { dismissedAt } — completion itself is always derived
  themePreference       String? // "light" | "dark" | "system"
  notificationPrefs     Json? // { taskReminders, dailyDigest } — null = defaults on
  lastDigestAt          DateTime? // guards the daily digest against double-sending

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String? // better-auth organization plugin: currently-active org

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model SendingAccount {
  id             String    @id @default(uuid())
  organizationId String? // tenant scope
  name           String // e.g. "Support Desk" or "Personal Gmail"
  email          String
  provider       String    @default("smtp") // "smtp" | "gmail_oauth" | "managed"
  host           String? // SMTP host (null for gmail_oauth)
  port           Int       @default(587)
  secure         Boolean   @default(false)
  user           String? // SMTP user (null for gmail_oauth)
  pass           String? // SMTP app password (null for gmail_oauth)
  refreshToken   String? // Google OAuth refresh token (gmail_oauth only)
  from           String? // Optional customized "From" header (e.g. "John <john@domain.com>")
  active         Boolean   @default(true)
  // Reply-poller cursors (see lib/inbox/poller.ts)
  imapHost       String? // IMAP host for SMTP accounts (defaults host→imap if unset)
  imapPort       Int? // IMAP port (993)
  lastPolledAt   DateTime? // last successful inbound poll
  gmailHistoryId String? // Gmail API history cursor (gmail_oauth only)
  // When set, this mailbox's inbound mail is a lead-aggregator's notification email
  // (JustDial, Sulekha, TradeIndia — dev PRD §3.7-3.8's webhook-less fallback), parsed via
  // lib/email-lead-parser.ts and ingested as new leads instead of matched as a reply.
  leadSourceKey  String?
  // Per-account DKIM (SMTP accounts) — overrides the env default signing
  dkimDomain     String?
  dkimSelector   String?
  dkimPrivateKey String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Set when this mailbox was bought through the platform. Nothing downstream
  // branches on it — a managed mailbox is an ordinary SendingAccount, so warm-up,
  // the reply poller, deliverability and safeSend all keep working untouched.
  domainId String?
  domain   Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  campaigns Campaign[]
  warmup    Warmup?

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([domainId])
}

// ---- Deliverability: mailbox warm-up (see lib/warmup.ts, docs/rate-limits.md) ----
model Warmup {
  id               String         @id @default(uuid())
  organizationId   String? // tenant scope
  sendingAccountId String         @unique
  sendingAccount   SendingAccount @relation(fields: [sendingAccountId], references: [id], onDelete: Cascade)
  enabled          Boolean        @default(false)
  dailyTarget      Int            @default(6) // steady-state warm-up emails/day
  rampDays         Int            @default(21) // days to ramp from 2/day up to dailyTarget
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId])
}

model WarmupEvent {
  id                String   @id @default(uuid())
  organizationId    String? // tenant scope
  sendingAccountId  String
  direction         String // "sent" | "received"
  placement         String? // "inbox" | "spam" | null (unknown — send scope only)
  rescued           Boolean  @default(false) // moved spam → inbox
  providerMessageId String?
  at                DateTime @default(now())

  @@index([organizationId])
  @@index([sendingAccountId])
  @@index([at])
}

// ---- better-auth organization plugin (teams / members / roles / invites) ----
model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now())
  members     Member[]
  invitations Invitation[]

  // ---- app-owned org state ----
  // Nullable, no default — same reasoning as User's app-owned fields: better-auth's
  // organization plugin only writes the fields above, so a non-nullable addition here
  // would read as drift to `better-auth generate` and could break its inserts.
  // { startHour, endHour, timezoneOffsetMinutes, days: number[] } — gates the
  // auto-notification-on-capture send (lib/notify.ts). Null = sane built-in default.
  businessHours Json?

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member | group_leader
  createdAt      DateTime     @default(now())

  // ---- org hierarchy (PRD section 4): Admin -> Group Leader -> Member ----
  // Department is tagged at the group-leader level so one org can run Marketing,
  // Sales and Support side by side on the same core.
  department Department?
  // Self-referencing manager link — this is what the SLA escalation chain walks
  // (rep -> group leader -> admin) rather than a hardcoded three-tier lookup.
  managerId  String?
  manager    Member?     @relation("MemberHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Member[]    @relation("MemberHierarchy")

  @@unique([organizationId, userId])
  @@index([organizationId, department])
  @@index([managerId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String? // owner | admin | member
  status         String       @default("pending") // pending | accepted | rejected | canceled
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  // better-auth's organization plugin writes this on every invite. Its absence
  // made `prisma.invitation.create()` fail with "Unknown argument createdAt",
  // surfacing as a bare 500 from /api/auth/organization/invite-member — the
  // adapter passes the whole parsed object through, so a column it expects and
  // we do not have is a hard failure, not a silently ignored field.
  createdAt      DateTime     @default(now())

  @@map("invitation")
}

// ---- Leads: groups / saved segments ----
model Segment {
  id             String   @id @default(uuid())
  organizationId String? // tenant scope
  name           String
  kind           String   @default("static") // "static" (explicit leadIds) | "dynamic" (saved filter)
  leadIds        String[] @default([]) // static membership
  filter         Json     @default("{}") // dynamic filter: { tags?, stage?, companyContains? }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ---- Campaigns: per-lead enrollment state machine (see lib/campaign-engine.ts) ----
enum EnrollmentStatus {
  active
  paused
  completed
  replied
  bounced
  stopped
}

model Enrollment {
  id             String           @id @default(uuid())
  organizationId String? // tenant scope
  campaignId     String
  leadId         String
  status         EnrollmentStatus @default(active)
  currentNodeId  String? // node in the campaign graph the enrollment is at / about to run
  nextRunAt      DateTime?
  branch         String? // last branch taken (analytics)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([status, nextRunAt])
  @@index([organizationId])
}

// ---- Inbox: unified reply threads (see lib/inbox/poller.ts, app/dashboard/inbox) ----
enum ThreadStatus {
  unread
  read
  interested
  not_interested
  ooo
}

model InboxThread {
  id             String       @id @default(uuid())
  organizationId String? // tenant scope
  leadId         String?
  channel        Channel      @default(email)
  subject        String?
  status         ThreadStatus @default(unread)
  assignedTo     String? // userId
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lead     Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages InboxMessage[]

  @@index([organizationId])
  @@index([status])
}

model InboxMessage {
  id                String   @id @default(uuid())
  organizationId    String? // tenant scope
  threadId          String
  direction         String // "inbound" | "outbound"
  fromAddr          String?
  toAddr            String?
  subject           String?
  body              String?
  providerMessageId String? // Gmail message id / IMAP UID / SMTP id
  /// RFC-822 threading headers, kept verbatim. providerMessageId above is the
  /// provider's opaque id and is useless for correlation across mailboxes;
  /// these are the ones every mail client actually threads on.
  rfcMessageId      String?
  inReplyTo         String?
  references        String[] @default([])
  /// How this message was tied to a campaign — see lib/inbox/store.ts.
  /// header  = In-Reply-To/References matched a Message we sent (a real reply)
  /// thread  = continues a thread we already know
  /// address = the From address matched a contact, nothing more
  /// none    = unmatched
  matchKind         String   @default("none")
  sentAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  thread InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([threadId])
  @@index([providerMessageId])
  @@index([organizationId, rfcMessageId])
}

// ---- LinkedIn: companion Chrome-extension automation (see docs/channels.md, extension/) ----
// The official API can't send invites/DMs, so campaigns enqueue LinkedInActions and a
// browser extension drains them from the user's own logged-in LinkedIn session.
model LinkedInAccount {
  id                  String    @id @default(uuid())
  organizationId      String
  userId              String // the member whose LinkedIn session the extension drives
  extToken            String    @unique // bearer the Chrome extension authenticates with
  status              String    @default("pending") // pending | connected
  liMemberName        String? // display name the extension reports on check-in
  dailyInviteCap      Int       @default(20)
  dailyMessageCap     Int       @default(40)
  /// Rows a rep may pull from LinkedIn in a day. 80 profile loads is the
  /// community-safe ceiling (docs/phantombuster.md); reading a search results
  /// page is far cheaper than loading 80 profiles, so this counts ROWS rather
  /// than page loads and sits well above it.
  dailyScrapeCap      Int       @default(500)
  minDelaySec         Int       @default(45) // humanized pacing floor
  maxDelaySec         Int       @default(120)
  mode                String    @default("auto") // auto | invite | message — default action type
  /// Whether the extension clicks Send itself, or fills the box and waits.
  ///
  /// Off by default, deliberately: automated sending is against LinkedIn's User
  /// Agreement and the consequence lands on the member's own account. It runs in
  /// their own browser, on their own IP — not from our servers holding their
  /// session, which is the shape that gets accounts restricted fastest — but it
  /// is still their call to make rather than a default we make for them.
  autoSend            Boolean   @default(false)
  selectedCampaignIds String[]  @default([]) // empty = drain all campaigns' LinkedIn actions
  campaignSettings    Json      @default("{}") // per-campaign override: { [campaignId]: { cap, minDelaySec, maxDelaySec, mode, enabled } }
  lastSeenAt          DateTime?

  // ---- Official LinkedIn OAuth ----
  // Sign In with LinkedIn (OpenID Connect) + Share on LinkedIn. This is the
  // member's real, consented connection: LinkedIn tells us who they are and
  // lets us post as them. It does NOT grant search, invites or messaging —
  // no LinkedIn API tier sells those, which is why the extension still exists
  // alongside this rather than being replaced by it. See lib/linkedin/oauth.ts.
  liMemberId          String? // OIDC `sub` — LinkedIn's stable id for the person
  liPictureUrl        String?
  liEmail             String?
  liAccessToken       String? // ENCRYPTED — lib/db-encryption.ts
  liRefreshToken      String? // ENCRYPTED — partner-gated, usually absent
  liTokenExpiresAt    DateTime? // 60 days from consent; no refresh for most apps
  liScopes            String[]  @default([])
  liConnectedAt       DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model LinkedInAction {
  id             String    @id @default(uuid())
  organizationId String
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId     String?
  type           String    @default("auto") // auto | invite | message
  linkedinUrl    String
  note           String? // rendered invite note / message body
  // pending | in_progress (extension opening the tab) | drafted (filled, awaiting a human's
  // own Send click) | sent | failed | skipped
  status         String    @default("pending")
  result         String? // extension-reported detail
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sentAt         DateTime?

  @@index([organizationId, status])
  @@index([leadId])
}

// ===========================================================================
// Unified CRM core (product PRD v2, section 13 MVP)
//
// The pipeline engine is deliberately generic: one set of mechanics that any
// department configures for itself, rather than a sales pipeline that later
// gets copy-pasted for support and collections.
// ===========================================================================

enum Department {
  marketing
  sales
  support
  collections
  recruitment
}

/// How a stage terminates a pipeline. `open` stages are in-flight; won/lost are
/// terminal and stop SLA timers.
enum StageKind {
  open
  won
  lost
}

enum IdentityKind {
  email
  phone
  linkedin
  external
}

/// A request to read something off LinkedIn, run by the rep's own browser.
///
/// PhantomBuster's equivalent takes a session cookie and runs on their servers.
/// This carries no credential at all: the extension already IS the rep's logged-in
/// session, so a job is just "open this URL and tell me what you see". Which is
/// also why the queue is claim-based — the work happens on a machine we do not
/// control and may stop at any moment.
model LinkedInScrapeJob {
  id             String  @id @default(uuid())
  organizationId String
  /// Whose LinkedIn session will run it. Results belong to them.
  userId         String
  /// search_export | profile_scrape | company_employees | … (lib/linkedin/detect.ts)
  /// Derived from the URL rather than chosen, so this is recorded, not requested.
  kind           String
  /// The page to open, normalised (tracking params stripped, query kept).
  inputUrl       String
  /// What the person typed, when they searched by keyword rather than pasting.
  inputQuery     String?
  maxResults     Int     @default(100)

  /// queued → running → done | failed | cancelled
  status        String    @default("queued")
  /// Rows seen so far, so a long scrape shows progress rather than a spinner.
  progress      Int       @default(0)
  resultCount   Int       @default(0)
  /// Distinguishes "LinkedIn changed its markup" from "this search is empty" —
  /// they look identical (zero rows) and need completely different responses.
  failureKind   String?
  error         String?
  /// The scraped rows, pre-import. Reviewed before anything becomes a contact:
  /// a wrong search URL should not put 2,000 wrong people in the database.
  results       Json      @default("[]")
  /// Set once the rep has chosen rows and imported them.
  importedAt    DateTime?
  importedCount Int       @default(0)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  // The extension polls for its own next job; the UI lists recent ones.
  @@index([organizationId, userId, status])
  @@index([organizationId, createdAt])
}

/// ---- Identity graph -------------------------------------------------------
/// Resolves a person across email, phone, LinkedIn handle and any future
/// identifier onto ONE Lead. The unique constraint is what makes a second
/// touch from a different channel merge instead of creating a duplicate.
model ContactIdentity {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind           IdentityKind
  /// Normalised at write time (lowercased email, E.164 phone, canonical
  /// linkedin path) so equality alone is enough to resolve.
  value          String
  /// Which adapter first supplied this identifier.
  source         String?
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, kind, value])
  @@index([leadId])
  @@index([organizationId])
}

/// ---- WhatsApp templates ----------------------------------------------------
/// Outside the 24h session window (see lib/channels/whatsapp.ts), only an approved
/// template may be sent — this is what a sender picks from once that path is built.
/// Enforcement (refusing a free-form send outside the window) doesn't depend on this
/// table existing; it's the future "which template" management surface.
model WhatsAppTemplate {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  twilioContentSid String
  approved         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// ---- Lead sources + ROI ---------------------------------------------------
model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  /// Stable machine key: meta_lead_ads | google_ads | indiamart | justdial |
  /// web_form | manual | csv | …
  key            String
  label          String
  /// Recurring spend for this source, so cost-per-conversion is derivable
  /// rather than a separate BI exercise.
  monthlyCost    Decimal? @db.Decimal(12, 2)
  active         Boolean  @default(true)

  // ---- auto-assignment (lib/assignment.ts) ----
  // Which rep a contact from this source lands on. Lives here rather than in a
  // separate rule table because one source has one rule — and Settings → Sources
  // is already where people manage sources, so the rule sits with the thing it
  // describes.
  //
  // manual      — leave unassigned (it shows in the Unassigned view)
  // round_robin — rotate through the pool, cursor below
  // workload    — fewest open contacts in the pool wins
  // fixed       — always assignedToId
  assignmentRule     String      @default("manual")
  /// Only meaningful for `fixed`. A raw userId, matching Task.ownerId's
  /// convention: memberships are per-org and change without the work moving.
  assignedToId       String?
  /// Which department's members form the pool. Null = the whole workspace.
  assignmentDept     Department?
  /// Round-robin cursor. Stored per source, so IndiaMART and Meta Ads each
  /// rotate independently rather than fighting over one shared position.
  lastAssignedUserId String?

  createdAt DateTime @default(now())

  leads Lead[]
  items PipelineItem[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

/// ---- Generic pipeline engine ---------------------------------------------
model Pipeline {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  department     Department @default(sales)
  isDefault      Boolean    @default(false)
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())

  /// manual | round_robin | workload — territory/source-based rules aren't modeled (no
  /// territory concept exists yet), so those aren't offered as options.
  assignmentRule       String  @default("manual")
  /// round_robin's cursor — the userId assigned last, so the next pick continues from there.
  lastAssignedMemberId String?

  stages PipelineStage[]
  items  PipelineItem[]

  @@unique([organizationId, name])
  @@index([organizationId, department])
}

model PipelineStage {
  id         String    @id @default(cuid())
  pipelineId String
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  position   Int
  kind       StageKind @default(open)
  /// Hours an item may sit here before it counts as breached. Null = no SLA.
  slaHours   Int?
  createdAt  DateTime  @default(now())

  items PipelineItem[]

  @@unique([pipelineId, position])
  @@index([pipelineId])
}

/// One contact travelling through one pipeline. Unique per (pipeline, lead) so
/// a contact cannot be double-assigned into the same funnel.
model PipelineItem {
  id             String        @id @default(cuid())
  organizationId String
  pipelineId     String
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Assigned rep. Raw userId — memberships are per-org and may change.
  ownerId        String?
  value          Decimal?      @db.Decimal(12, 2)
  sourceId       String?
  source         LeadSource?   @relation(fields: [sourceId], references: [id])
  enteredStageAt DateTime      @default(now())
  /// Derived from the stage's slaHours on every move; null when the stage has
  /// no SLA or the item is closed.
  slaDueAt       DateTime?
  slaBreachedAt  DateTime?
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transitions StageTransition[]
  escalations EscalationEvent[]

  @@unique([pipelineId, leadId])
  @@index([organizationId, stageId])
  @@index([organizationId, ownerId])
  // Drives the ageing sweep: find everything overdue without a table scan.
  @@index([slaDueAt, slaBreachedAt])
}

/// Every stage move, including who or what caused it. `actorKind = "ai"` is how
/// the PRD's headline metric — share of moves driven by AI extraction rather
/// than a rep updating a dropdown — becomes measurable.
model StageTransition {
  id          String       @id @default(cuid())
  itemId      String
  item        PipelineItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromStageId String?
  toStageId   String
  /// forward | backward — backward moves require a reason.
  direction   String
  reason      String?
  actorId     String?
  /// user | ai | system
  actorKind   String       @default("user")
  at          DateTime     @default(now())

  @@index([itemId, at])
}

model EscalationEvent {
  id             String        @id @default(cuid())
  organizationId String
  /// Exactly one of itemId / taskId is set. Prisma cannot express that, so it is
  /// enforced by the two callers that write here.
  itemId         String?
  item           PipelineItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// 1 = owner, 2 = group leader, 3 = admin — follows the org hierarchy.
  level          Int
  toUserId       String?
  /// in_app | email | whatsapp | sms | push
  channel        String        @default("in_app")
  sentAt         DateTime      @default(now())
  meta           Json          @default("{}")

  @@index([organizationId, sentAt])
  @@index([itemId])
  @@index([taskId])
}

/// ---- Unified conversation -------------------------------------------------
/// One timeline per resolved identity. Every channel adapter writes the same
/// shape here, so a WhatsApp acknowledgement, a manual call and a support reply
/// land on one thread rather than in three separate tables.
model ConversationEvent {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel        Channel
  /// inbound | outbound
  direction      String
  status         String?
  subject        String?
  body           String?
  /// Provider message id — the dedupe key for webhook retries.
  externalId     String?
  occurredAt     DateTime @default(now())
  meta           Json     @default("{}")
  createdAt      DateTime @default(now())

  @@unique([organizationId, channel, externalId])
  @@index([organizationId, leadId, occurredAt])
}

/// ---- Next action ----------------------------------------------------------
/// The product's central promise — "I'll remember what you need to do next" —
/// needs somewhere to remember it. A Task is one owed action against one contact.
/// Deliberately not a project-management object: no subtasks, no dependencies,
/// no projects. It exists so a lead cannot fall through the cracks.
enum TaskKind {
  follow_up
  call
  email
  whatsapp
  linkedin
  meeting
  other
}

/// Ordered low to high so `orderBy: { priority: "desc" }` sorts the way a human
/// expects. `none` is the default because most tasks genuinely are not ranked,
/// and a required priority just trains people to pick one at random.
enum TaskPriority {
  none
  low
  medium
  high
}

enum TaskStatus {
  open
  done
  cancelled
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  /// Nullable so a standalone reminder is possible, but in practice every task
  /// created by the product hangs off a contact.
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  pipelineItemId String?
  title          String
  /// Longer context for whoever picks this up — "what exactly do you want said".
  /// Separate from Note, which is a human's words about the *contact*.
  instruction    String?
  kind           TaskKind     @default(follow_up)
  priority       TaskPriority @default(none)
  status         TaskStatus   @default(open)
  dueAt          DateTime?
  /// Assigned rep. Raw userId — memberships are per-org and may change.
  ownerId        String?
  createdBy      String?
  /// user | ai | system — so "we created this follow-up for you" stays visible
  /// rather than looking like something the rep forgot they typed.
  createdKind    String       @default("user")
  completedAt    DateTime?
  /// The one nudge sent to the owner. Null-guarded so a retry cannot re-send.
  remindedAt     DateTime?
  /// The one escalation sent to the owner's manager — mirrors PipelineItem.slaBreachedAt.
  escalatedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  escalations EscalationEvent[]

  // Drives the Today/Overdue/Upcoming buckets without a table scan.
  @@index([organizationId, status, dueAt])
  @@index([organizationId, ownerId, status])
  // The reminder sweep runs across every org, so it needs an index that is not
  // org-scoped.
  @@index([status, dueAt])
  @@index([leadId])
}

/// In-app notifications.
///
/// Assigning work used to be silent: createTask wrote ownerId and returned, and
/// the only thing that ever reached a person was a due-date reminder (which
/// fires when it is already too late to plan) and the 8am digest. So work could
/// sit on someone for days before they knew it existed.
///
/// Email alone was not enough either — it lands in the same inbox as the
/// outreach the product sends, and the person is usually already in the app.
model Notification {
  id             String    @id @default(cuid())
  organizationId String
  /// Recipient. A raw userId, matching Task.ownerId's convention.
  userId         String
  /// task_assigned | lead_assigned | … — what happened, for grouping and icons.
  kind           String
  title          String
  body           String?
  /// Where clicking it goes.
  href           String?
  /// What it is about, so a stale notification can be resolved against reality.
  entityType     String?
  entityId       String?
  /// Null until read. Nullable rather than a boolean so "when" is recoverable.
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  // Unread-first, newest-first, for one person — the only query the bell makes.
  @@index([userId, readAt, createdAt])
  @@index([organizationId])
}

/// A human's own words on a contact. Separate from ConversationEvent, which is
/// reserved for things that actually happened on a channel — a note is internal
/// and was never sent to anyone.
model Note {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  @@index([organizationId, leadId, createdAt])
}

// ==================================================================
// Sending domains & managed mailboxes — see docs/domains-and-mailboxes.md
//
// A workspace buys a lookalike domain in our reseller storefront so cold
// outreach never runs on the domain its invoices go out on. The store takes the
// payment and credits us the margin, so there is no order or payment table here
// — what we track is the domain and whether its mail records actually resolve.
// ==================================================================

enum DomainStatus {
  /// Records recorded, waiting for public DNS to agree.
  dns_pending
  /// Every record resolves — this domain can send.
  active
  /// Verification gave up; needs a human.
  failed
  expired
}

enum DnsRecordKind {
  MX
  SPF
  DKIM
  DMARC
}

enum DnsRecordStatus {
  pending
  verified
  mismatch
  missing
}

/// A domain the workspace sends from.
model Domain {
  id             String       @id @default(uuid())
  organizationId String
  /// Lowercase, no trailing dot. Unique per org, not globally — two workspaces
  /// could legitimately both manage the same domain in a reseller setup.
  name           String
  status         DomainStatus @default(dns_pending)
  /// String rather than an enum so a second registrar is a data change.
  registrar      String       @default("godaddy")
  /// The registrar's id for the registration — used to poll it and to renew.
  registrarRef   String?
  /// "auto"   = on our nameservers, we write the records ourselves.
  /// "manual" = customer's nameservers, they paste what we show them.
  dnsMode        String       @default("auto")
  nameservers    String[]     @default([])
  /// Which mail product the records point at, so the expected record set can be
  /// recomputed later without another provider round-trip.
  mailProvider   String?
  expiresAt      DateTime?
  autoRenew      Boolean      @default(true)
  verifiedAt     DateTime?
  failureReason  String?
  /// The DB is the source of truth for what is due; the queue is only transport
  /// (same contract as Enrollment.nextRunAt — see docs/ARCHITECTURE.md).
  nextCheckAt    DateTime?
  /// How many verification passes have run, so backoff can widen and eventually
  /// give up instead of polling a misconfigured domain forever.
  checkAttempts  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  records   DomainDnsRecord[]
  mailboxes SendingAccount[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([status, nextCheckAt])
}

/// One record the domain needs before it can send, and what the public
/// resolver last returned for it.
model DomainDnsRecord {
  id            String          @id @default(uuid())
  domainId      String
  domain        Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  kind          DnsRecordKind
  /// The DNS type a resolver answers with — MX, TXT, CNAME.
  type          String
  /// Host relative to the domain: "@", "_dmarc", "selector1._domainkey".
  host          String
  expectedValue String
  /// What the resolver actually returned. Shown beside the expected value on a
  /// mismatch, so a typo is visible rather than merely reported.
  observedValue String?
  priority      Int?
  status        DnsRecordStatus @default(pending)
  lastCheckedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([domainId, kind, host])
  @@index([domainId])
}
