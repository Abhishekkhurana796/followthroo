# ============================================================
# LeadsKonnect — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Every integration degrades gracefully if its vars are missing
# (the app boots; that channel is just reported as "not configured").
# ============================================================

# ---- App ----
NODE_ENV=development
# The APP (dashboard, auth, API), not the marketing site. followthroo.com is the
# separate public showcase site — see middleware.ts, which redirects between the
# two custom domains in production. Locally this stays localhost either way.
# Prod: https://app.followthroo.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ char random string used to sign sessions / internal tokens
BETTER_AUTH_SECRET=
# Optional fallback for the same purpose, read by lib/ingest-key.ts when
# BETTER_AUTH_SECRET is unset. One of the two MUST be set: the per-org webhook
# key is an HMAC of it, so with neither, every org's ingest key is an HMAC of
# the empty string and therefore publicly computable.
APP_SECRET=

# ---- Encryption at rest (lib/crypto.ts, lib/db-encryption.ts) ----
# Mailbox passwords, OAuth refresh tokens and DKIM private keys are AES-256-GCM
# encrypted in the database. Without a key here the app refuses to store a new
# credential rather than silently writing it in plaintext.
#
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Then set:  ENCRYPTION_KEYS=v1:<that value>
#
# Use a DIFFERENT key per environment, and treat it like the database password:
# lose every key listed here and every encrypted credential is unrecoverable.
#
# Rotating: ADD the new key (ENCRYPTION_KEYS=v1:<old>,v2:<new>) — the highest
# version becomes the one new writes use, while old rows still open with v1.
# Then run `npx tsx --env-file=.env.local scripts/encrypt-backfill.ts --rotate`
# and only remove v1 once it reports no rows left on it.
ENCRYPTION_KEYS=
# Optional — pin which key new writes use. Defaults to the highest version above.
ENCRYPTION_ACTIVE_KEY=
# REQUIRED in production. Vercel sends this automatically as
# "Authorization: Bearer <value>" on every vercel.json cron invocation, and
# lib/cron-auth.ts verifies it. Without it every scheduled job 401s silently
# while still looking like it ran. 16+ random characters.
CRON_SECRET=

# ---- Database (PostgreSQL) ----
# e.g. postgresql://user:password@localhost:5432/leadskonnect
DATABASE_URL=

# ---- Redis (for BullMQ job queue / rate-limit counters) ----
# e.g. redis://localhost:6379
REDIS_URL=

# ---- Upstash QStash (serverless campaign queue — drains queued sends on Vercel) ----
# When set (and NEXT_PUBLIC_APP_URL is not localhost), queued sends are published to
# QStash, which HTTP-calls /api/qstash/process on schedule — no long-lived worker needed.
# Falls back to BullMQ/REDIS_URL locally. Get these from the Upstash QStash console.
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---- Platform SMTP: INTERNAL notifications only (Nodemailer) ----
# This mailbox sends Followthroo's own mail to Followthroo's own users — new-lead
# alerts and SLA escalations. It is NEVER used to reach a contact: outreach goes out
# through a SendingAccount each workspace connects for itself, so mail carries their
# domain and reputation and their replies land somewhere the poller actually reads.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Followthroo <no-reply@yourdomain.com>"
# DKIM (optional but recommended for deliverability)
DKIM_DOMAIN=
DKIM_KEY_SELECTOR=default
DKIM_PRIVATE_KEY=

# ---- Email: "Connect Gmail" via Google OAuth (one-click sending accounts) ----
# Google Cloud → OAuth 2.0 Client (Web). Enable the Gmail API. Consent screen in
# "Testing" mode + add yourself as a test user to skip verification. Authorized
# redirect URIs: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback (prod + localhost).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- WhatsApp: Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender, e.g. whatsapp:+14155238886 (sandbox) or your number
TWILIO_WHATSAPP_FROM=

# ---- LinkedIn ----
# Official API (org pages). Personal automation is browser-based (see docs/channels.md).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Register this exact URL in the LinkedIn Developer Portal, Auth tab:
#   https://app.followthroo.com/api/linkedin/oauth/callback
# Scopes depend on which Products your LinkedIn app has been granted. Asking for
# one the app does not hold fails the whole consent with "Invalid scope", so trim
# this to match: "openid profile email" if only Sign In is approved.
LINKEDIN_SCOPES=openid profile email w_member_social
# LinkedIn versions its REST API by month. Pinned deliberately.
LINKEDIN_API_VERSION=202506
LINKEDIN_ACCESS_TOKEN=
# Browser automation session cookie (li_at) — use with extreme care, gray area
LINKEDIN_LI_AT=

# ---- Zoho (sign in with Zoho + connect a Zoho mailbox) ----
# Create the client at the API console for YOUR datacenter
# (api-console.zoho.in for India, .com for US, .eu / .com.au / .jp elsewhere).
# Client Type MUST be "Server-based Applications" — the client-based type issues
# no refresh token, so a connected mailbox stops sending about an hour later.
#
# Authorized Redirect URIs to register (all four):
#   https://app.followthroo.com/api/auth/oauth2/callback/zoho   <- sign in
#   https://app.followthroo.com/api/auth/zoho/callback          <- connect mailbox
#   http://localhost:3000/api/auth/oauth2/callback/zoho
#   http://localhost:3000/api/auth/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Which Zoho datacenter your ACCOUNTS live in: in | com | eu | com.au | jp | ca | sa
# Tokens are region-locked — an Indian account authenticated against .com fails
# with an opaque "invalid_code". Defaults to "in". The mailbox-connect flow reads
# the real region back from Zoho's redirect, so this is only the starting point.
ZOHO_DC=in

# ---- Inbound lead source: Meta Lead Ads (/api/inbound/meta_lead_ads) ----
# Any string you choose — paste the same value into Meta's webhook "Verify Token"
# field; it's what answers Meta's GET subscribe challenge.
META_VERIFY_TOKEN=
# Meta App Dashboard → Settings → Basic → App Secret. Verifies the
# x-hub-signature-256 header on every inbound webhook POST.
META_APP_SECRET=
# Long-lived Page access token (Meta Business Suite). The webhook only carries
# a leadgen_id; this fetches the actual field values via the Graph API.
META_PAGE_ACCESS_TOKEN=
# Inbound web forms, IndiaMART, JustDial, Sulekha, and TradeIndia need no vars here —
# their ingest key is derived from BETTER_AUTH_SECRET at request time (see lib/ingest-key.ts).

# ---- Email provider webhook (/api/webhooks/email) ----
# Bounces / complaints / opens. REQUIRED for that endpoint to accept anything:
# it writes suppressions, so with no secret set it rejects every request rather
# than letting anyone bounce another workspace's list into silence.
# Send it as an HMAC-SHA256 of the raw body in X-Webhook-Signature, or as the
# raw value in X-Webhook-Secret / ?key=.
EMAIL_WEBHOOK_SECRET=

# ---- Inbound lead source: Google Ads Lead Forms (/api/inbound/google_ads) ----
# Any string you choose — paste the same value as the webhook key in the lead form
# asset's "Other data integration options" → Webhook integration config.
GOOGLE_ADS_WEBHOOK_KEY=

# ---- IndiaMART historical backfill (scripts/indiamart-backfill.ts) ----
# Separate from the Push webhook — a distinct Pull API key, generated on the same
# seller.indiamart.com → Lead Manager page. Expires after 7 days unused.
INDIAMART_PULL_API_KEY=

# ---- AI agent (OpenRouter — preferred) ----
# openrouter.ai/keys. OpenRouter's Anthropic-compatible endpoint speaks the same
# Messages API as Anthropic direct, tool use included, so the app uses one SDK for
# both. Model ids here are OpenRouter's and are provider-prefixed.
# Set this OR ANTHROPIC_API_KEY below; OpenRouter wins when both are present.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2
# Optional. Comma-separated ids OpenRouter falls back to when the primary is
# unavailable — this is the failover, rather than a second provider integration.
OPENROUTER_FALLBACK_MODELS=
# Optional; defaults to OPENROUTER_MODEL. Runs on every inbound reply, so a
# smaller/cheaper model here is usually the right call.
OPENROUTER_CLASSIFIER_MODEL=

# ---- AI agent (Anthropic direct — alternative to OpenRouter above) ----
# console.anthropic.com → API Keys. Powers the tool-calling orchestration loop
# (send_message / move_stage / update_lead_fields / draft_message) AND, on a
# smaller/cheaper model, reply-intent classification on every inbound reply.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# ---- AI agent (NVIDIA — legacy, superseded by Claude above) ----
# No longer used by lib/agent.ts; left here only if you still want the OpenAI-
# compatible NVIDIA endpoint for something else.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ---- Rate-limit defaults (override the safe defaults if you must) ----
RL_EMAIL_PER_HOUR=40
RL_LINKEDIN_PER_DAY=20
RL_WHATSAPP_PER_DAY=250

# ---- Reseller storefront (domains + Professional Email) ----
# The white-labelled GoDaddy/Wild West Domains storefront customers are sent to.
# The store takes the payment and credits us the margin, so there is no API key
# and no payment gateway here. RESELLER_PLID is the private-label id that
# attributes the sale — get it wrong and the customer still buys, but we earn
# nothing. Both have working defaults; override only to point at another store.
RESELLER_PLID=601578
RESELLER_STOREFRONT_URL=https://www.secureserver.net

# Where the Windows desktop app installer is published (desktop/README.md).
# ~80MB, so host it as an object (Vercel Blob, R2, S3) or a public GitHub
# release asset — never in public/, which would ride along in every deploy.
# Unset renders "ask your admin" rather than a download button that 404s.
NEXT_PUBLIC_DESKTOP_APP_URL=
